    [استدلال الگوریتمی], [—], [✓], [—],
    [کیفیت و ساختار کد], [—], [✓], [—],
    [مصالحه‌های معماری], [✓], [—], [✓],
    [رفتار در برابر خطا], [✓], [✓], [✓],
    [ارتباط و توضیح‌دهی], [✓], [✓], [✓],
  )
]

ستون آخر این ماتریس به شما نشان می‌دهد کجا سؤال کم دارید — و مهم‌تر، کجا سه سؤال
دارید که همگی یک چیز را می‌سنجند.

